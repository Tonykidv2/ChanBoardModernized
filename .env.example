# MongoDB Connection
MONGO_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/
DATABASE_NAME=ChanBoardDb

# JWT Configuration
JWT_SECRET=your-secret-key-minimum-32-characters-long
JWT_ISSUER=ChanBoardModernized.API
JWT_AUDIENCE=ChanBoardModernized.Web
JWT_EXPIRATION_HOURS=12

# MongoDB for local development (optional)
MONGO_DB_CONNECTION_STRING_LOCAL=mongodb://admin:StrongPassword123@localhost:27017/?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme123