FROM nginx:alpine

# Remove default nginx configs
RUN rm -rf /etc/nginx/conf.d/*

# Create directory for logs
RUN mkdir -p /var/log/nginx

# Copy nginx main configuration (optional - if you have custom nginx.conf)
# COPY nginx.conf /etc/nginx/nginx.conf

# Note: The actual site config will be mounted as a volume from docker-compose
# This keeps the Dockerfile generic and environment-agnostic

# Expose ports
EXPOSE 80 443

# Use default nginx entrypoint
CMD ["nginx", "-g", "daemon off;"]